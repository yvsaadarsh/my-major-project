# ------------------------------------------------------------------
# Project OS — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (migrations + runtime pg adapter).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_os?schema=public"

# Secret used to sign session JWTs (HS256). MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional. When set, its hostname is used to scope the session cookie domain.
# Leave unset for local development so the cookie defaults to the request host.
# NEXTAUTH_URL="https://app.example.com"

# Node environment. Prisma keeps a hot client in dev; production disables that.
NODE_ENV="development"

# Required for AI features (src/lib/ai). Server-side only — no NEXT_PUBLIC_
# prefix, so it is never bundled into client JavaScript. Get one from
# https://console.anthropic.com/settings/keys
# Without it, AI features are disabled; the rest of the platform runs normally.
ANTHROPIC_API_KEY=sk-ant-...