# ------------------------------------------------------------------
# Project OS — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (migrations + runtime pg adapter).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_os?schema=public"

# Secret used to sign session JWTs (HS256). MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session cookies are host-only; no NEXTAUTH_URL setting is required.

# Node environment. Prisma keeps a hot client in dev; production disables that.
NODE_ENV="development"

# Required for AI features (src/lib/ai). Server-side only — no NEXT_PUBLIC_
# prefix, so it is never bundled into client JavaScript. Get one from
# https://aistudio.google.com/apikey
# Without it, AI features are disabled; the rest of the platform runs normally.
GEMINI_API_KEY=AIza...

# Optional. Override the Gemini models the AI layer uses without a code change.
# GEMINI_QUALITY_MODEL="gemini-2.5-pro"
# GEMINI_FAST_MODEL="gemini-2.5-flash"

# Optional. Reliability knobs for the Gemini client (sensible defaults applied).
# GEMINI_TIMEOUT_MS="30000"      # per-request timeout in ms (default 30000)
# GEMINI_RETRY_ATTEMPTS="3"      # total attempts incl. original, transient-only, capped at 5 (default 3)
# Optional total generation budgets (including thinking), capped at 8192.
# GEMINI_FAST_MAX_TOKENS=4096
# GEMINI_QUALITY_MAX_TOKENS=4096
